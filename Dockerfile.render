# Single-origin Render pilot: build React into Spring Boot static assets.
FROM node:22-alpine AS frontend-build
WORKDIR /ui
COPY frontend/package.json frontend/tsconfig.json frontend/index.html ./
COPY frontend/src ./src
RUN npm install --no-audit --no-fund && npm run build

FROM maven:3.9-eclipse-temurin-17 AS backend-build
WORKDIR /build
COPY backend/pom.xml ./pom.xml
COPY backend/src ./src
COPY --from=frontend-build /ui/dist ./src/main/resources/static
RUN mvn -B -ntp -DskipTests package

FROM eclipse-temurin:17-jre
WORKDIR /app
RUN groupadd -r app && useradd -r -g app app
COPY --from=backend-build /build/target/backend-*.jar /app/billing-copilot.jar
COPY deploy/render-entrypoint.sh /app/render-entrypoint.sh
RUN chmod 0555 /app/render-entrypoint.sh && chown -R app:app /app
USER app
EXPOSE 10000
ENTRYPOINT ["/app/render-entrypoint.sh"]
