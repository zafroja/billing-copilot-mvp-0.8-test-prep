# Copy to .env on the private pilot server. DO NOT commit, upload or share .env.
# APP_DOMAIN is a DNS name you control. HTTPS will be provisioned by Caddy.
APP_DOMAIN=pilot.example.com
DATABASE_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
PILOT_USERNAME=owner
# Bcrypt hash only, generated using `htpasswd -nB -C 12 owner` (copy after colon)
# Put bcrypt hash in single quotes to prevent Docker Compose $ interpolation.
PILOT_PASSWORD_BCRYPT='REPLACE_WITH_BCRYPT_HASH'
# Generate with: openssl rand -base64 32; back up in a secure secret manager.
TOKEN_ENCRYPTION_KEY_B64=REPLACE_WITH_32_BYTE_BASE64
JOBBER_CLIENT_ID=REPLACE_WITH_CLIENT_ID
JOBBER_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
PILOT_CURRENCY=EUR
JOBBER_API_VERSION=2026-05-12
